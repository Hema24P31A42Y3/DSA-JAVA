package programs;

public class recursionn {
	static double premium(int months,double amount) {
		if(months==0) {
			return amount;
		}
		amount = (amount + amount * 0.10);
		return premium(months-1,amount);
	}
	public static void main(String args[]) {
		double result=premium(3,10000);
		System.out.println("total amount="+result);
	}
}
